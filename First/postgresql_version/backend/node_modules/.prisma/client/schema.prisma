// Prisma schema for Evaluation Portal Phase 1

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DB_URL")
}

// ---------- Enums ----------
enum Role {
  ADMIN
  HOD
  FACULTY
}

enum SchemeStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  RETURNED_FOR_CORRECTION
  DELETED
}

enum ComponentType {
  THEORY
  PRACTICAL
  PROJECT
  OTHER
}

enum ReferenceType {
  TEXTBOOK
  REFERENCE
}

enum CommentType {
  COMMENT
  RETURN
  APPROVAL
}

// ---------- Models ----------
model User {
  id           Int         @id @default(autoincrement())
  name         String
  email        String      @unique
  passwordHash String
  role         Role
  department   Department? @relation("UserDepartment", fields: [departmentId], references: [id])
  departmentId Int?
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?

  // Relations used by seed script
  assignments CourseAssignment[]

  // HOD relation (optional, one-to-one)
  hodDepartment Department? @relation("HODDepartment")

  // Indexes
  @@index([departmentId], name: "idx_user_department")
  @@index([email], name: "idx_user_email")
}

model Department {
  id       Int       @id @default(autoincrement())
  name     String
  code     String    @unique
  hod      User?     @relation("HODDepartment", fields: [hodId], references: [id])
  hodId    Int?      @unique
  programs Program[]
  users    User[]    @relation("UserDepartment")
  courses  Course[]  @relation("DepartmentCourses")
}

model Program {
  id           Int        @id @default(autoincrement())
  name         String
  department   Department @relation(fields: [departmentId], references: [id])
  departmentId Int
  semesters    Semester[]
}

model Semester {
  id           Int      @id @default(autoincrement())
  number       Int
  academicYear String
  program      Program  @relation(fields: [programId], references: [id])
  programId    Int
  courses      Course[]
}

model Course {
  id           Int                @id @default(autoincrement())
  code         String             @unique
  title        String
  type         String // CORE | ELECTIVE | LAB
  credits      Int
  L            Int
  T            Int
  P            Int
  semester     Semester           @relation(fields: [semesterId], references: [id])
  semesterId   Int
  department   Department         @relation("DepartmentCourses", fields: [departmentId], references: [id])
  departmentId Int
  assignments  CourseAssignment[]
}

model CourseAssignment {
  id           Int    @id @default(autoincrement())
  course       Course @relation(fields: [courseId], references: [id])
  courseId     Int
  faculty      User   @relation(fields: [facultyId], references: [id])
  facultyId    Int
  academicYear String
}

// The remaining models (TeachingScheme, SchemeVersion, CourseOutcome, Unit, Topic, TopicCO,
// AssessmentComponent, AssessmentComponentUnit, Reference, Comment, Attachment, Notification,
// AuditLog) are omitted because they are not required for the current seed script.
